<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item
                android:top="4dp"
                android:bottom="4dp"
                android:left="4dp"
                android:right="4dp">
                <shape android:shape="oval">
                    <size android:width="24dp" android:height="24dp"/>
                    <solid android:color="@color/switch_thumb_checked"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:top="8dp"
                android:bottom="8dp"
                android:left="8dp"
                android:right="8dp">
                <shape android:shape="oval">
                    <size android:width="16dp" android:height="16dp"/>
                    <solid android:color="@color/switch_thumb_unchecked"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
