<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <size android:width="52dp" android:height="32dp"/>
            <solid android:color="@color/switch_track_checked"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <size android:width="52dp" android:height="32dp"/>
            <stroke android:width="2dp" android:color="@color/switch_track_stroke"/>
            <solid android:color="@color/switch_track_unchecked"/>
        </shape>
    </item>
</selector>
