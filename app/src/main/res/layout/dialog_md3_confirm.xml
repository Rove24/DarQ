<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_md3_dialog"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/dialog_icon_container"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_dialog_icon_container">

                <ImageView
                    android:id="@+id/dialog_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_clear"
                    app:tint="#D2E3FC" />

            </FrameLayout>

            <TextView
                android:id="@+id/dialog_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:fontFamily="@font/google_sans_text_bold"
                android:text="@string/data_settings_clear_dialog_title"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/dialog_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/google_sans_text"
            android:lineSpacingMultiplier="1.25"
            android:text="@string/data_settings_clear_dialog_message"
            android:textColor="#9AA0A6"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_dialog_btn_cancel"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/google_sans_text_medium"
                android:gravity="center"
                android:minWidth="80dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/cancel"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_confirm"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_dialog_btn_confirm"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/google_sans_text_bold"
                android:gravity="center"
                android:minWidth="80dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/confirm"
                android:textColor="#00325B"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
