<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_md3_dialog"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/dialog_icon_container"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_dialog_icon_container">

                <ImageView
                    android:id="@+id/dialog_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_developer_options_service_info"
                    app:tint="#D2E3FC" />

            </FrameLayout>

            <TextView
                android:id="@+id/bottom_sheet_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:fontFamily="@font/google_sans_text_bold"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                tools:text="标题" />

        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/bottom_sheet_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxHeight="320dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/bottom_sheet_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans_text"
                android:lineSpacingMultiplier="1.3"
                android:textColor="#9AA0A6"
                android:textSize="14sp"
                tools:text="正文说明内容..." />

        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/bottom_sheet_buttons_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bottom_sheet_neutral"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_dialog_btn_cancel"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/google_sans_text_medium"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#9AA0A6"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="更多信息"
                tools:visibility="visible" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/bottom_sheet_negative"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_dialog_btn_cancel"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/google_sans_text_medium"
                android:gravity="center"
                android:minWidth="72dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="关闭"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/bottom_sheet_positive"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_dialog_btn_confirm"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/google_sans_text_bold"
                android:gravity="center"
                android:minWidth="72dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="#00325B"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="确定"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>