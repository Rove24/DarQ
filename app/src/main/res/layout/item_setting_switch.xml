<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/padding_16"
    android:layout_marginEnd="@dimen/padding_16"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="68dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/item_setting_switch_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:padding="8dp"
            tools:src="@drawable/ic_app_whitelist_round" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="@dimen/padding_16"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="@dimen/padding_8"
            android:paddingBottom="@dimen/padding_8">

            <TextView
                android:id="@+id/item_setting_switch_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium.Darq"
                android:textColor="?android:textColorPrimary"
                tools:text="Setting Title" />

            <TextView
                android:id="@+id/item_setting_switch_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.AppCompat.Small.Darq"
                android:textColor="?android:textColorSecondary"
                android:visibility="gone"
                tools:text="Setting Content"
                tools:visibility="visible" />

        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/item_setting_switch_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/padding_16"
            android:background="@null"
            android:clickable="false"
            android:focusable="false"
            android:showText="false"
            android:thumb="@drawable/md3_switch_thumb"
            app:switchMinWidth="52dp"
            app:track="@drawable/md3_switch_track" />

    </LinearLayout>

</LinearLayout>