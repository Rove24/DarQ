<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:transitionGroup="true">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Service Operations Group -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_16"
            android:layout_marginTop="@dimen/padding_16"
            android:layout_marginEnd="@dimen/padding_16"
            android:orientation="vertical">

            <!-- Kill Service Card -->
            <LinearLayout
                android:id="@+id/card_kill_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_group_card_top"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/padding_16"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/padding_16"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_kill_service_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/google_sans_text_medium"
                        android:text="@string/item_developer_options_kill_service_title"
                        android:textAppearance="@style/TextAppearance.AppCompat.Medium.Darq"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/text_kill_service_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/google_sans_text"
                        android:text="@string/item_developer_options_kill_service_content"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small.Darq"
                        android:textColor="?android:textColorSecondary"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Service Info Card -->
            <LinearLayout
                android:id="@+id/card_service_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_group_card_bottom"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/padding_16"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/padding_16"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_service_info_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/google_sans_text_medium"
                        android:text="@string/item_developer_options_service_info"
                        android:textAppearance="@style/TextAppearance.AppCompat.Medium.Darq"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/text_service_info_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/google_sans_text"
                        android:text="@string/item_developer_options_service_info_not_connected"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small.Darq"
                        android:textColor="?android:textColorSecondary"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>