<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_setting_about_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/item_setting_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:padding="8dp"
        tools:src="@drawable/ic_app_whitelist_round" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_setting_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium.Darq"
            android:textColor="?android:textColorPrimary"
            tools:text="Setting Title" />

        <TextView
            android:id="@+id/item_setting_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Small.Darq"
            android:textColor="?android:textColorPrimary"
            android:visibility="gone"
            tools:text="Setting Content"
            tools:visibility="visible" />

    </LinearLayout>

    <com.google.android.material.chip.Chip
        android:id="@+id/chip_github"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_gravity="center_vertical"
        android:text="@string/chip_github"
        android:textAppearance="@style/TextAppearance.AppCompat.Small.Darq.Medium"
        app:chipBackgroundColor="@color/icon_circle_6"
        app:chipIcon="@drawable/ic_github"
        app:chipIconTint="@color/icon_inside_6"
        app:chipStartPadding="8dp" />

</LinearLayout>